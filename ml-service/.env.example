# Runtime
CARDIOFUSION_HOST=0.0.0.0
CARDIOFUSION_PORT=3002
MAX_DOWNLOAD_BYTES=52428800

# Optional extraction assistant. Never used for disease prediction.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-flash-latest,gemini-flash-lite-latest

# Optional project knowledge retrieval. Never used to calculate probabilities.
PINECONE_API_KEY=
PINECONE_INDEX=
PINECONE_NAMESPACE=

# Optional checkpoint overrides. Leave unset to use the selected-model defaults.
# BIOMARKER_CHECKPOINT=checkpoints/biomarkers/biomarker_ft_transformer.pt
# ECG_CHECKPOINT=checkpoints/ecg/ptbxl/selected_cnn_bilstm/v1/model.pt
# ECHO_CHECKPOINT=checkpoints/echo/echonet/r2plus1d_baseline/v1/model.pt

# Echo backend: auto (PanEcho if its checkpoint exists, else R(2+1)D) | panecho | r2plus1d
ECHO_MODEL_BACKEND=auto
# Optional explicit PanEcho weights. Default search order:
#   checkpoints/echo/echonet/selected_panecho/v1/model.pt
# PANECHO_CHECKPOINT=checkpoints/echo/panecho/pretrained/v1/model.pt
# Clips averaged per echo video (more = steadier EF, slower on CPU)
PANECHO_NUM_CLIPS=4
