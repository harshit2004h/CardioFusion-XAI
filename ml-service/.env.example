# Runtime
CARDIOFUSION_HOST=your_cardiofusion_host_here
CARDIOFUSION_PORT=your_cardiofusion_port_here
MAX_DOWNLOAD_BYTES=your_max_download_bytes_here

# Optional extraction assistant. Never used for disease prediction.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=your_gemini_model_here

# Optional project knowledge retrieval. Never used to calculate probabilities.
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX=your_pinecone_index_here
PINECONE_NAMESPACE=your_pinecone_namespace_here

# Optional trained artifact locations.
BIOMARKER_CHECKPOINT=checkpoints/biomarkers/biomarker_ft_transformer.pt
ECG_CHECKPOINT=checkpoints/ecg/ptbxl_xresnet1d101.pt
ECHO_CHECKPOINT=checkpoints/echo/echonet_r2plus1d18.pt